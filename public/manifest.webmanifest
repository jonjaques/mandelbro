{
  "name": "Mandelbro",
  "short_name": "Mandelbro",
  "description": "Zoom endlessly into the Mandelbrot set right in your browser. Perturbation theory and arbitrary-precision math reveal fractal detail far beyond ordinary viewers. Share any location with a link.",
  "id": "/",
  "scope": "/",
  "start_url": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "fullscreen",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/appicon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/appicon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-home.png",
      "sizes": "720x1280",
      "type": "image/png",
      "label": "Mandelbro explorer view on mobile"
    },
    {
      "src": "/screenshots/desktop-home-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Mandelbro wide install preview on desktop"
    }
  ]
}
