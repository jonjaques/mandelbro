---
/**
 * Dynamic per-location SEO landing pages.
 *
 * One static page is generated for every entry in `PRESET_LANDING_PAGES`
 * (e.g. `/seahorse-valley`, `/elephant-valley`). Each page:
 *
 *   1. Has unique title/description/H1/body so it can rank on long-tail
 *      queries like "seahorse valley mandelbrot" or "minibrot location".
 *   2. Links into the explorer with the right view encoded in the URL
 *      hash, so visitors land directly on the location.
 *
 * The explorer itself is *not* embedded — these are content pages, not
 * thin canvas-only pages, so search engines see substantial body text.
 */
import MainLayout from "@/layouts/main.astro";
import { BRAND_NAME } from "@/lib/mandelbrot/constants";
import { AUTHOR_NAME, AUTHOR_URL, SOURCE_CODE_URL } from "@/lib/site-config";
import {
  PRESET_LANDING_PAGES,
  type PresetLandingPage,
} from "@/lib/mandelbrot/preset-pages";

interface Props {
  page: PresetLandingPage;
}

export function getStaticPaths() {
  return PRESET_LANDING_PAGES.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(page.path, siteBase);
const explorerUrl = `/${page.initialHash}`;

const otherPresets = PRESET_LANDING_PAGES.filter((p) => p.slug !== page.slug);

const authorEntity = {
  "@type": "Person" as const,
  name: AUTHOR_NAME,
  url: AUTHOR_URL,
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: `${page.name} — Mandelbrot Set Deep Zoom`,
    description: page.metaSummary,
    url: canonicalUrl.toString(),
    author: authorEntity,
    publisher: authorEntity,
    mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl.toString() },
    about: [
      {
        "@type": "Place",
        name: page.name,
        description: page.metaSummary,
      },
      {
        "@type": "Thing",
        name: "Mandelbrot set",
        sameAs: "https://en.wikipedia.org/wiki/Mandelbrot_set",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: BRAND_NAME,
        item: siteBase.toString(),
      },
      {
        "@type": "ListItem",
        position: 2,
        name: page.name,
        item: canonicalUrl.toString(),
      },
    ],
  },
];

const coordsDisplay = `${page.centerX.toPrecision(8)} ${
  page.centerY >= 0 ? "+ " : "- "
}${Math.abs(page.centerY).toPrecision(8)}i`;
const zoomDisplay = page.zoom.toExponential(3);
---

<MainLayout
  title={page.title}
  description={page.description}
  scrollable
  canonicalPath={page.path}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
  />

  <div class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <header class="mb-12">
      <a
        href="/"
        class="mb-6 inline-flex items-center gap-1.5 text-sm text-sky-300/80 transition-colors hover:text-sky-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="m15 18-6-6 6-6"></path>
        </svg>
         Back to Explorer
      </a>
      <p class="text-sm uppercase tracking-wider text-sky-300/70">
        Mandelbrot set deep zoom
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        {page.name}
      </h1>
      <p class="mt-4 text-base leading-relaxed text-white/60">
        {page.metaSummary}
      </p>
    </header>

    <div
      class="mb-10 flex flex-col gap-3 rounded-lg border border-white/10 bg-white/5 p-5 sm:flex-row sm:items-center sm:justify-between"
    >
      <dl class="flex flex-col gap-1 font-mono text-xs text-white/70">
        <div class="flex gap-2">
          <dt class="text-white/40">Center:</dt>
          <dd class="tabular-nums">{coordsDisplay}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-white/40">Zoom:</dt>
          <dd class="tabular-nums">{zoomDisplay}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-white/40">Palette:</dt>
          <dd class="capitalize">{page.colorScheme}</dd>
        </div>
      </dl>
      <a
        href={explorerUrl}
        class="inline-flex items-center justify-center rounded-md bg-sky-500/90 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-sky-400"
      >
        Open in explorer →
      </a>
    </div>

    <main
      class="text-white/80 [&_a]:text-sky-300/90 [&_a]:underline [&_a]:decoration-sky-500/40 [&_a]:underline-offset-2 hover:[&_a]:text-sky-200 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight [&_h2]:text-white [&_p]:mt-4 [&_p]:leading-relaxed"
    >
      <h2>About {page.name}</h2>
      <p>{page.body}</p>

      <h2>About the Mandelbrot set</h2>
      <p>
        The <a href="/about">Mandelbrot set</a> is the set of complex numbers
        <em>c</em> for which the iteration <em>z<sub>n+1</sub> = z<sub>n</sub><sup
            >2</sup
          > + c</em
        > does not escape to infinity. Its boundary is a fractal of infinite
        detail: every region you zoom into reveals new spirals, dendrites, and
        miniature copies of the entire set. {page.name} is one of the most
        recognizable patterns in this boundary.
      </p>

      <h2>How {BRAND_NAME} renders this view</h2>
      <p>
        At this zoom level, {BRAND_NAME} uses standard double-precision
        rendering with a parallel pool of Web Workers — every CPU core in your
        device runs the escape-time algorithm in parallel on a slice of the
        viewport. Push the zoom another twelve orders of magnitude in and the
        renderer automatically switches to its <a href="/references"
          >perturbation pipeline</a
        >, which uses one high-precision reference orbit to keep deep zooms
        sharp. See <a href="/about">how Mandelbro works</a> for the full
        explanation.
      </p>
    </main>

    <section class="mt-16 border-t border-white/10 pt-8">
      <h2 class="text-base font-semibold tracking-tight text-white">
        Other famous Mandelbrot locations
      </h2>
      <ul class="mt-4 flex flex-col gap-2.5 border-l border-white/15 pl-4">
        {
          otherPresets.map((p: PresetLandingPage) => (
            <li>
              <a
                href={p.path}
                class="text-sm text-sky-300/90 underline decoration-sky-500/40 underline-offset-2 transition-colors hover:text-sky-200 hover:decoration-sky-300/70"
              >
                {p.name}
              </a>{" "}
              <span class="text-sm text-white/50">— {p.shortSummary}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="mt-16 border-t border-white/10 pt-8">
      <p class="text-sm text-white/40">
        <a
          href="/"
          class="text-white/50 underline underline-offset-2 transition-colors hover:text-white/70"
          >{BRAND_NAME}</a
        > is a free, open-source Mandelbrot set explorer.{" "}
        <a
          href={SOURCE_CODE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/50 underline underline-offset-2 transition-colors hover:text-white/70"
          >View source on GitHub</a
        >.
      </p>
    </footer>
  </div>
</MainLayout>
