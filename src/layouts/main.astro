---
import "../styles/global.css";
import {
  BRAND_NAME,
  SITE_DESCRIPTION,
  SITE_KEYWORDS,
  SITE_TITLE,
} from "@/lib/mandelbrot/constants";
import {
  ANALYTICS_GTAG_LOADER_BASE,
  analyticsInlineSnippet,
  APPLE_MOBILE_WEB_APP_CAPABLE,
  APPLE_STATUS_BAR_STYLE,
  APPLE_TOUCH_ICONS,
  ASSET_ICON_SVG_PATH,
  ASSET_WEB_MANIFEST_PATH,
  DEFAULT_PREVIEW_IMAGE_PATH,
  FONT_PRECONNECT_GOOGLE,
  FONT_PRECONNECT_GSTATIC,
  FONT_STYLESHEET_GOOGLE,
  FONT_STYLESHEET_MACULA,
  HTML_DOCUMENT_LANG,
  mainLayoutStructuredData,
  META_ROBOTS_NOINDEX,
  META_THEME_COLOR,
  META_VIEWPORT,
  MOBILE_WEB_APP_CAPABLE,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_MIME_JPEG,
  OG_IMAGE_WIDTH,
  OG_LOCALE,
  OG_SOCIAL_CARD_IMAGE_ALT,
  OG_TYPE_WEBSITE,
  TWITTER_CARD_LARGE_IMAGE,
} from "@/lib/mandelbrot/main-layout-metadata";
import { AUTHOR_NAME, AUTHOR_URL } from "@/lib/site-config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  /** When true, html/body allow normal scrolling instead of fullscreen overflow:hidden. */
  scrollable?: boolean;
  /**
   * If set, canonical and og:url use this pathname only (no query string).
   * Use for `/references` when ephemeral `?return=` state should not duplicate SEO URLs.
   */
  canonicalPath?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = DEFAULT_PREVIEW_IMAGE_PATH,
  noIndex = false,
  scrollable = false,
  canonicalPath,
} = Astro.props;

const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(
  canonicalPath !== undefined
    ? canonicalPath
    : `${Astro.url.pathname}${Astro.url.search}`,
  siteBase,
);
const imageUrl = new URL(image, siteBase);

const authorEntity = { "@type": "Person" as const, name: AUTHOR_NAME, url: AUTHOR_URL };

const gaKey = import.meta.env.PUBLIC_GA_ID;
const hasAnalytics =
  import.meta.env.PROD && typeof gaKey === "string" && gaKey.length > 0;
const gaScript = hasAnalytics ? analyticsInlineSnippet(gaKey) : "";

const structuredData = mainLayoutStructuredData({
  canonicalUrl: canonicalUrl.toString(),
  description,
  imageUrl: imageUrl.toString(),
  authorEntity,
});
---

<!doctype html>
<html lang={HTML_DOCUMENT_LANG} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content={META_VIEWPORT} />
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE_KEYWORDS} />
    <meta name="author" content={AUTHOR_NAME} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={META_THEME_COLOR} />
    <meta name="mobile-web-app-capable" content={MOBILE_WEB_APP_CAPABLE} />
    <meta name="apple-mobile-web-app-capable" content={APPLE_MOBILE_WEB_APP_CAPABLE} />
    <meta name="apple-mobile-web-app-title" content={title} />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content={APPLE_STATUS_BAR_STYLE}
    />
    {noIndex && <meta name="robots" content={META_ROBOTS_NOINDEX} />}

    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" type="image/svg+xml" href={ASSET_ICON_SVG_PATH} />
    <link rel="manifest" href={ASSET_WEB_MANIFEST_PATH} />
    {
      APPLE_TOUCH_ICONS.map((entry) =>
        "sizes" in entry ? (
          <link rel="apple-touch-icon" sizes={entry.sizes} href={entry.href} />
        ) : (
          <link rel="apple-touch-icon" href={entry.href} />
        ),
      )
    }
    <link rel="preconnect" href={FONT_PRECONNECT_GOOGLE} />
    <link rel="preconnect" href={FONT_PRECONNECT_GSTATIC} crossorigin />
    <link href={FONT_STYLESHEET_GOOGLE} rel="stylesheet" />
    <link href={FONT_STYLESHEET_MACULA} rel="stylesheet" />

    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={OG_TYPE_WEBSITE} />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:locale" content={OG_LOCALE} />
    <meta property="og:image" content={imageUrl.toString()} />
    <meta property="og:image:alt" content={OG_SOCIAL_CARD_IMAGE_ALT} />
    <meta property="og:image:width" content={OG_IMAGE_WIDTH} />
    <meta property="og:image:height" content={OG_IMAGE_HEIGHT} />
    <meta property="og:image:type" content={OG_IMAGE_MIME_JPEG} />

    <meta name="twitter:card" content={TWITTER_CARD_LARGE_IMAGE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.toString()} />
    <meta name="twitter:image:alt" content={OG_SOCIAL_CARD_IMAGE_ALT} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    {
      hasAnalytics && (
        <script
          is:inline
          async
          src={`${ANALYTICS_GTAG_LOADER_BASE}?id=${gaKey}`}
        />
      )
    }
    {hasAnalytics && <script is:inline set:html={gaScript} />}
  </head>
  <body class:list={[scrollable && "scrollable"]}>
    <slot />
  </body>
</html>
